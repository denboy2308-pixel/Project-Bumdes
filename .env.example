# ==========================================
# BUMDES WASKITA WIJAYA - PRODUCTION CONFIG
# Desa Waru, Kec. Baki, Kab. Sukoharjo
# ==========================================

# Server & Environment Runtime
NODE_ENV="production"
PORT=3000

# Canonical Public Domain & URL
APP_URL="https://bumdeswaskita.desa.id"
PRODUCTION_DOMAIN="bumdeswaskita.desa.id"

# Security & HTTPS Enforcer
ENABLE_HTTPS_REDIRECT="true"
SESSION_SECRET="change-this-to-a-very-secure-random-string-at-least-32-chars"

# Allowed CORS Origins (comma-separated if multiple)
CORS_ALLOWED_ORIGINS="https://bumdeswaskita.desa.id"

# Optional Initial Administrator Bootstrap (Run once on fresh setup, then clear)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# AI Studio & Gemini API Runtime Key
GEMINI_API_KEY=""

# Firebase Client Configuration (Frontend SDK)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Firebase Admin SDK Credentials (Server runtime only - keep secret)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

